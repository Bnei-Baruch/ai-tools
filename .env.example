# Transcription
REACT_APP_MQTT_URL=
REACT_APP_WEB_URL=
REACT_APP_AI_BACKEND=
REACT_APP_EXEC_API=

# Keycloak
REACT_APP_KEYCLOAK_URL=https://accounts.kab.info/auth
REACT_APP_KEYCLOAK_REALM=main
REACT_APP_KEYCLOAK_CLIENT_ID=ai-tools

# stt-api (speakers, docdiff, tadiff)
REACT_APP_STT_API=https://sttapi.kli.one/api

# ai-trns (תמלול, בדיקת תמלול): users' Keycloak tokens
REACT_APP_AI_TRNS_API=https://ai-tools.kab.info/ai-trns

# Other STT tools
# stt-api's transcription (השוואת תמלול can use it instead of ai-trns); empty = the default below
REACT_APP_STT_URL=https://ai-tools.kab.info/stt-api/stt/transcribe
REACT_APP_STT_MODEL=whisper-prev
REACT_APP_ALIGN_URL=

# STT review (בדיקת תמלול): empty = ai-trns;
# "local" reads public/review/main.json and keeps results in the browser (for trying it out only)
REACT_APP_REVIEW_API=

# Live transcription (תמלול חי): the broadcast's HLS stream; the ai-trns API must allow its host
REACT_APP_LIVE_STREAM_URL=https://edge3.uk.kab.tv/live/heb-medium/playlist.m3u8
# Google Doc written from the browser as the user: OAuth client id (web app, this origin, Docs API); empty = off.
# Writing from the server instead: AI_TRNS_GOOGLE_CREDENTIALS in ai-trns
REACT_APP_GOOGLE_CLIENT_ID=
