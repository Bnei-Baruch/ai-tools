   "chunks": [
    {
     "start": 120.4,
     "end": 124.0,
     "text": "זהו טקסט לדוגמה בלבד ולא תמלול אמיתי"
    },
    {
     "start": 124.4,
     "end": 128.0,
     "text": "הוא נועד לבדוק את מסך הבדיקה"
    },
    {
     "start": 128.4,
     "end": 132.0,
     "text": "לחצו על שורה כדי לערוך אותה"
    },
    {
     "start": 132.4,
     "end": 136.0,
     "text": "אחרי התיקון בחרו את סוג הטעות"
    },
    {
     "start": 136.4,
     "end": 140.0,
     "text": "אפשר להוסיף הערה לכל שורה"
    },
    {
     "start": 140.4,
     "end": 144.0,
     "text": "המקש רווח עוצר ומפעיל את הנגן"
    },
    {
     "start": 144.4,
     "end": 148.0,
     "text": "החצים למעלה ולמטה עוברים בין השורות"
    },
    {
     "start": 148.4,
     "end": 152.0,
     "text": "המקש אר חוזר לתחילת השורה"
    },
    {
     "start": 152.4,
     "end": 156.0,
     "text": "בסוף לוחצים על סיימתי"
    },
